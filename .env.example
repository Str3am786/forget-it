# ---- chat model: compression, reader and judge ---------------------------
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=qwen2.5:7b-instruct

# ---- embedding model: dense retrieval, semantic policies, compression ----
# semantic, semantic_coverage, semantic_keep and compression all call it,
# even when no dense retriever is selected.
EMBED_BASE_URL=
EMBED_API_KEY=
EMBED_MODEL=qwen3-embedding:0.6b            # Thesis campaign embedder
EXPECTED_EMBED_MODEL=qwen3-embedding:0.6b   # run fails if the served model differs
EMBED_MAX_INPUT_CHARS=28000                 # the thesis campaign's input cap

# ---- caches (optional) ----------------------------------------------------
# Repeat runs replay from these. Delete them to force fresh calls.
LLM_CACHE_DIR=./cache/llm
EMBED_CACHE_PATH=./cache/embeddings.sqlite

# ---- Letta (optional) -------------------------------------------------------
# Only for the Letta memory-system wrapper. No thesis experiment uses it.
LETTA_BASE_URL=
LETTA_API_KEY=


